/* Outpost 全部 Toolkit 窗口共用的主题样式。
   uxml 内经 <Style src="Outpost.uss"/> 引用（backend 只 clone uxml、不单独挂 uss——引用随 clone 生效）。
   色板：警戒橙 #FF9E40 为主题色，深空蓝灰为底。 */

/* ── 全屏页（标题 / 结算） ─────────────────────────────── */

.op-page {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    justify-content: center;
    align-items: center;
    color: rgb(217, 224, 242);
}

.op-page--title,
.op-page--result { background-color: rgb(12, 20, 30); }

.op-page--title { overflow: hidden; }

.op-title-radar {
    position: absolute;
    right: -180px;
    top: -160px;
    width: 780px;
    height: 780px;
    border-width: 1px;
    border-color: rgba(105, 145, 179, 0.15);
    border-radius: 390px;
}

.op-title-radar__ring,
.op-title-radar__core {
    position: absolute;
    left: 100px;
    top: 100px;
    right: 100px;
    bottom: 100px;
    border-width: 1px;
    border-color: rgba(105, 145, 179, 0.12);
    border-radius: 290px;
}

.op-title-radar__core {
    left: 220px;
    top: 220px;
    right: 220px;
    bottom: 220px;
    border-radius: 170px;
}

.op-title-radar__horizontal {
    position: absolute;
    top: 50%;
    left: -180px;
    right: 0;
    height: 1px;
    background-color: rgba(105, 145, 179, 0.10);
}

.op-title-radar__vertical {
    position: absolute;
    left: 50%;
    top: 0;
    bottom: -180px;
    width: 1px;
    background-color: rgba(105, 145, 179, 0.10);
}

.op-title-layout {
    flex-direction: row;
    align-items: center;
    width: 90%;
    max-width: 1200px;
    min-height: 360px;
    padding: 40px 44px;
    border-left-width: 3px;
    border-left-color: rgb(255, 158, 64);
    border-top-width: 1px;
    border-top-color: rgb(43, 62, 81);
    border-bottom-width: 1px;
    border-bottom-color: rgb(43, 62, 81);
    background-color: rgba(18, 29, 42, 0.96);
}

.op-title-brand { flex-grow: 1; flex-shrink: 1; }
.op-title-brand .op-title { font-size: 68px; letter-spacing: 4px; margin-bottom: 18px; }

.op-title-menu {
    width: 32%;
    min-width: 310px;
    max-width: 330px;
    margin-left: 48px;
    padding-left: 30px;
    border-left-width: 1px;
    border-left-color: rgb(48, 66, 84);
}

.op-title-menu .op-btn { min-width: 0; width: 100%; height: 44px; font-size: 16px; margin-top: 10px; }
.op-title-menu .op-btn--primary { height: 50px; margin-top: 0; margin-bottom: 8px; }

.op-title {
    -unity-font-style: bold;
    font-size: 36px;
    color: rgb(255, 158, 64);
    letter-spacing: 3px;
    margin-bottom: 12px;
}

.op-label {
    color: rgb(217, 224, 242);
    font-size: 14px;
    margin-bottom: 10px;
    white-space: normal;
}

.op-title-subtitle { font-size: 18px; }

.op-title-record {
    font-size: 14px;
    margin-top: 28px;
    margin-bottom: 0;
    padding-top: 18px;
    border-top-width: 1px;
    border-top-color: rgb(48, 66, 84);
}

/* 次要信息（历史战绩等）——比正文更收敛的灰蓝 */
.op-label--dim { color: rgb(166, 184, 204); }

/* 结算判定行（主动撤离 / 哨站失守），颜色由代码按结局设置 */
.op-verdict { font-size: 22px; -unity-font-style: bold; margin-bottom: 18px; }

.op-result-content {
    width: 460px;
    max-width: 90%;
    padding: 24px 28px;
    background-color: rgb(18, 29, 42);
    border-top-width: 3px;
    border-top-color: rgb(255, 158, 64);
}

.op-result-content .op-title { font-size: 28px; letter-spacing: 1px; }
.op-result-detail { font-size: 17px; }
.op-result-record { margin-top: 8px; font-size: 12px; }
.op-result-actions { margin-top: 10px; }
.op-result-actions .op-btn { min-width: 0; }

.op-btn {
    margin-top: 8px;
    min-width: 220px;
    height: 36px;
    font-size: 14px;
    color: rgb(217, 224, 242);
    background-color: rgb(28, 43, 59);
    background-image: none;
    border-width: 2px;
    border-color: rgb(76, 99, 120);
    border-radius: 5px;
}

.op-btn:hover:enabled {
    color: rgb(255, 224, 187);
    background-color: rgb(41, 60, 79);
    border-color: rgb(255, 158, 64);
}

.op-btn:focus { border-color: rgb(255, 206, 150); }

.op-btn:active {
    color: rgb(18, 26, 36);
    background-color: rgb(255, 158, 64);
    border-color: rgb(255, 206, 150);
}

.op-btn--primary {
    -unity-font-style: bold;
    color: rgb(18, 26, 36);
    background-color: rgb(255, 158, 64);
    border-color: rgb(255, 158, 64);
}

.op-btn--primary:hover:enabled,
.op-btn--primary:focus {
    background-color: rgb(255, 184, 106);
    border-color: rgb(255, 222, 180);
}

.op-btn--primary:active { background-color: rgb(224, 129, 43); }

.op-btn:disabled {
    color: rgb(145, 160, 182);
    background-color: rgb(24, 35, 49);
    border-color: rgb(52, 67, 83);
}

/* ── 模态卡片（框架看点弹窗） ──────────────────────────── */

/* 卡片外层定位容器：铺满并居中卡片；picking-mode 在 uxml 上设为 Ignore（点击透传给遮罩/下层） */
.op-overlay {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: rgba(4, 10, 18, 0.35);
}

.op-card {
    /* 用确定宽度而非 max-width：收缩容器里的换行 Label 会先按无界宽度测高（单行）、
       再被 max-width 钳住换行——父容器高度不随之重算，条目互相压叠。定宽让首轮测量即约束。 */
    width: 520px;
    max-width: 92%;
    max-height: 88%;
    flex-shrink: 1;
    background-color: rgb(19, 30, 43);
    color: rgb(217, 224, 242);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgb(58, 78, 99);
    border-top-width: 3px;
    border-top-color: rgb(255, 158, 64);
}

.op-card__header {
    flex-shrink: 0;
    padding: 14px 20px 12px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(43, 62, 81);
}

.op-card__body {
    flex-shrink: 1;
    min-height: 0;
    padding: 12px 20px;
}

.op-card__body .unity-scroll-view__content-container { padding-right: 4px; }

.op-card__footer {
    flex-shrink: 0;
    padding: 10px 20px 14px;
    border-top-width: 1px;
    border-top-color: rgb(43, 62, 81);
}

.op-card__subtitle { font-size: 12px; margin-top: 5px; margin-bottom: 0; }

.op-card .op-card__footer .op-btn { margin-top: 0; min-width: 0; }

.op-card__body .unity-scroller--vertical { width: 10px; }

.op-card__body .unity-scroller .unity-base-slider__tracker {
    background-color: rgb(14, 23, 34);
    border-width: 0;
}

.op-card__body .unity-scroller .unity-base-slider__dragger {
    background-color: rgb(76, 99, 120);
    border-width: 0;
    border-radius: 3px;
}

.op-card__body .unity-scroller .unity-base-slider__dragger:hover {
    background-color: rgb(255, 158, 64);
}

.op-card__body .unity-scroller .unity-button {
    background-color: rgb(26, 40, 55);
    border-width: 0;
}

.op-card__title {
    -unity-font-style: bold;
    font-size: 19px;
    color: rgb(255, 158, 64);
    margin-bottom: 0;
    white-space: normal;
}

/* 一条「看点」= 单个富文本 Label（橙色小标题行 + 灰色说明行，颜色/字号走 rich text 标签）。
   刻意不做「标题 Label + 说明 Label 套容器」的嵌套：容器高度按子元素首轮（未换行）测量结果结算、
   说明换行后不回填父高，条目会互相压叠——单 Label 自测自高没有这层不同步。 */
.op-bullet {
    font-size: 12px;
    color: rgb(191, 205, 223);
    white-space: normal;
    margin-bottom: 12px;
    padding-bottom: 10px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(39, 57, 75);
}

/* 脚注小灰字（指向文档路径等） */
.op-hint {
    color: rgb(156, 173, 194);
    font-size: 11px;
    margin-top: 4px;
    white-space: normal;
}

/* 卡片内按钮比全屏页按钮矮一档 */
.op-card .op-btn {
    height: 34px;
    margin-top: 6px;
}

/* ── 设置弹窗 ─────────────────────────────────────────── */

.op-card--settings { width: 460px; }

.op-settings-audio {
    padding-bottom: 10px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(43, 62, 81);
}

.op-slider {
    margin: 7px 0;
    color: rgb(217, 224, 242);
}

.op-slider .unity-base-field__label { min-width: 72px; color: rgb(217, 224, 242); }

.op-slider .unity-base-slider__tracker {
    background-color: rgb(52, 74, 96);
    border-color: rgb(76, 99, 120);
    border-radius: 3px;
}

.op-slider .unity-base-slider__dragger {
    background-color: rgb(255, 158, 64);
    background-image: none;
    border-width: 2px;
    border-color: rgb(18, 26, 36);
    border-radius: 4px;
}

.op-slider:hover .unity-base-slider__dragger { background-color: rgb(255, 184, 106); }

.op-slider:focus .unity-base-slider__dragger,
.op-slider .unity-base-slider__input:focus .unity-base-slider__dragger {
    border-color: rgb(255, 222, 180);
}

.op-slider:disabled .unity-base-slider__dragger {
    background-color: rgb(115, 131, 149);
    border-color: rgb(24, 35, 49);
}

.op-card .unity-base-popup-field__input,
.op-page .unity-base-popup-field__input {
    color: rgb(217, 224, 242);
    background-color: rgb(28, 43, 59);
    background-image: none;
    border-width: 2px;
    border-color: rgb(76, 99, 120);
    border-radius: 5px;
}

.op-card .unity-base-popup-field__input:hover,
.op-page .unity-base-popup-field__input:hover {
    background-color: rgb(41, 60, 79);
    border-color: rgb(255, 158, 64);
}

.op-card .unity-base-popup-field:focus > .unity-base-popup-field__input,
.op-page .unity-base-popup-field:focus > .unity-base-popup-field__input,
.op-card .unity-base-popup-field__input:focus,
.op-page .unity-base-popup-field__input:focus {
    border-color: rgb(255, 206, 150);
}

.op-card .unity-base-popup-field__text,
.op-page .unity-base-popup-field__text { color: rgb(217, 224, 242); }

.op-card .unity-base-popup-field__arrow,
.op-page .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: rgb(255, 158, 64);
}

/* 语言选择行：标签 + 两个语言按钮并排 */
.op-lang-row {
    flex-direction: row;
    align-items: center;
    margin-top: 10px;
}

.op-lang-row__label { width: 80px; flex-shrink: 0; font-size: 12px; margin-bottom: 0; margin-right: 8px; }

.op-btn--lang,
.op-card .op-btn--lang {
    min-width: 0;
    flex-grow: 1;
    flex-shrink: 1;
    margin-top: 0;
    margin-right: 8px;
    border-width: 2px;
    border-color: rgb(76, 99, 120);
}

/* 当前语言的按钮描边高亮（代码按 Locale 切换该类；后端选择行复用同一套类） */
.op-btn--lang-active {
    color: rgb(255, 184, 106);
    background-color: rgb(63, 48, 33);
    border-color: rgb(255, 158, 64);
}

.op-btn--lang-active:hover:enabled { background-color: rgb(81, 59, 35); }
.op-btn--lang-active:focus { border-color: rgb(255, 222, 180); }

/* 设置项下的小字提示（如后端切换「下一局生效」） */
.op-settings__hint {
    font-size: 11px;
    color: rgb(156, 173, 194);
    margin-top: 5px;
    white-space: normal;
}

/* 扩展内容区（增援电台）：浅色顶边与滑条区分隔 */
.op-expansion {
    margin-top: 14px;
    padding-top: 14px;
    border-top-width: 1px;
    border-top-color: rgba(120, 132, 165, 0.35);
}

.op-expansion__head {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.op-expansion__name { margin-bottom: 0; }

/* 状态短语（已启用 / 失败）：随代码换 key，绿色系表示"装好了" */
.op-expansion__status { margin-bottom: 0; color: rgb(140, 214, 160); }

.op-expansion__desc {
    font-size: 11px;
    color: rgb(156, 173, 194);
    margin-top: 5px;
    white-space: normal;
}

/* 下载进度条：容器暗槽 + 橙色填充（宽度百分比由代码驱动） */
.op-progress {
    height: 6px;
    margin-top: 8px;
    background-color: rgba(20, 26, 44, 0.9);
    border-radius: 3px;
}

.op-progress__fill {
    height: 100%;
    width: 0;
    background-color: rgb(255, 158, 64);
    border-radius: 3px;
}

/* ── 排行榜弹窗 ───────────────────────────────────────── */

.op-card--leaderboard { width: 520px; }

.op-lb-list { margin-top: 2px; margin-bottom: 8px; }

/* 一行 = 名次 | 署名(撑满) | 波次 | 分数，行视图由 BindList 工厂代码构建 */
.op-lb-row {
    flex-direction: row;
    align-items: center;
    padding: 8px;
    border-radius: 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(39, 57, 75);
}

.op-lb-row__rank {
    width: 30px;
    -unity-font-style: bold;
    font-size: 13px;
    color: rgb(255, 158, 64);
}

.op-lb-row__name {
    flex-grow: 1;
    font-size: 13px;
    color: rgb(217, 224, 242);
}

.op-lb-row__wave {
    width: 70px;
    font-size: 12px;
    color: rgb(166, 184, 204);
    -unity-text-align: middle-right;
}

.op-lb-row__score {
    width: 84px;
    font-size: 13px;
    color: rgb(217, 224, 242);
    -unity-text-align: middle-right;
}

/* 自己的署名行（存档 Callsign 匹配时代码加此类） */
.op-lb-row--self { background-color: rgba(255, 158, 64, 0.14); }
.op-lb-row--self .op-lb-row__name { color: rgb(255, 158, 64); }

/* 底部操作行：刷新 / 关闭并排 */
.op-lb-actions {
    flex-direction: row;
    justify-content: space-between;
}

.op-btn--half { min-width: 0; width: 48%; }

/* 结算页的全服名次行（有名次才显示，颜色随"上榜"语气走主题橙） */
.op-rank { color: rgb(255, 158, 64); }
